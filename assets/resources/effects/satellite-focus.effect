CCEffect %{
  techniques:
  - passes:
    - vert: map-vs:vert
      frag: map-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: false
      rasterizerState:
        cullMode: none
      properties:
        blurStep: { value: [0, 0, 0, 0] }
        tileReveal: { value: [0.5, 0.5, 0, 0] }
}%

CCProgram map-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  out vec2 uv;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv = a_texCoord;
    return cc_matViewProj * position;
  }
}%

CCProgram map-fs %{
  precision highp float;
  in vec2 uv;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform Focus {
    vec4 blurStep;
    vec4 tileReveal;
  };
  vec4 frag () {
    vec2 grid = (uv - tileReveal.xy) * blurStep.zw * vec2(9.0, 5.0);
    vec2 tile = floor(grid + vec2(0.5));
    vec2 offset = abs(grid - tile);
    float feather = smoothstep(0.36, 0.5, max(offset.x, offset.y));
    float order = mix(length(tile), length(grid), feather);
    float delay = min(0.73, order * 0.12);
    float clear = smoothstep(delay, delay + 0.22, tileReveal.z);
    vec2 d = blurStep.xy * (1.0 - clear);
    vec4 sampleColor = texture(cc_spriteTexture, uv);
    if (d.x <= 0.0) return sampleColor;
    sampleColor *= 4.0;
    sampleColor += 2.0 * texture(cc_spriteTexture, uv + vec2(d.x, 0.0));
    sampleColor += 2.0 * texture(cc_spriteTexture, uv - vec2(d.x, 0.0));
    sampleColor += 2.0 * texture(cc_spriteTexture, uv + vec2(0.0, d.y));
    sampleColor += 2.0 * texture(cc_spriteTexture, uv - vec2(0.0, d.y));
    sampleColor += texture(cc_spriteTexture, uv + d);
    sampleColor += texture(cc_spriteTexture, uv - d);
    sampleColor += texture(cc_spriteTexture, uv + vec2(d.x, -d.y));
    sampleColor += texture(cc_spriteTexture, uv + vec2(-d.x, d.y));
    return sampleColor / 16.0;
  }
}%
