{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM"],
    "types": []
  },
  "include": ["assets/scripts/**/*.ts"],
  "exclude": [
    "assets/scripts/Art.ts",
    "assets/scripts/Blackout.ts",
    "assets/scripts/TutorialGuideArt.ts"
  ]
}
